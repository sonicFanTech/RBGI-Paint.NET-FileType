<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- paint.NET 5.1+ uses .NET 9. If you target an older paint.NET build, change this to the framework that build uses. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>RBGIFileType</AssemblyName>
    <RootNamespace>RBGIFileTypePlugin</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>sonicFanTech</Company>
    <Authors>sonicFanTech</Authors>
    <Product>RBGI FileType Plugin for paint.NET</Product>
    <Description>Adds .RBGI Render Background Image load/save support to paint.NET.</Description>
    <Copyright>Copyright © sonicFanTech</Copyright>
    <Version>1.0.1</Version>

    <!-- Paint.NET's own sample projects suppress MSB3277 because framework assembly
         version "conflict" warnings are common when compiling against Paint.NET's DLLs. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Change this if paint.NET is installed somewhere else. -->
    <PaintNetInstallDir Condition="'$(PaintNetInstallDir)' == ''">C:\Program Files\paint.net</PaintNetInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- paint.NET plug-ins reference paint.NET's own assemblies. These should NOT be copied next to the plug-in DLL. -->
    <Reference Include="PaintDotNet.Base">
      <HintPath>$(PaintNetInstallDir)\PaintDotNet.Base.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PaintDotNet.ComponentModel">
      <HintPath>$(PaintNetInstallDir)\PaintDotNet.ComponentModel.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PaintDotNet.Core">
      <HintPath>$(PaintNetInstallDir)\PaintDotNet.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PaintDotNet.Data">
      <HintPath>$(PaintNetInstallDir)\PaintDotNet.Data.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PaintDotNet.Framework">
      <HintPath>$(PaintNetInstallDir)\PaintDotNet.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PaintDotNet.Fundamentals">
      <HintPath>$(PaintNetInstallDir)\PaintDotNet.Fundamentals.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PaintDotNet.Primitives">
      <HintPath>$(PaintNetInstallDir)\PaintDotNet.Primitives.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Optional: build with /p:AutoInstallToPaintNet=true to copy the DLL into the classic paint.NET FileTypes folder. -->
  <Target Name="CopyToPaintNetFileTypes" AfterTargets="Build" Condition="'$(AutoInstallToPaintNet)' == 'true'">
    <MakeDir Directories="$(PaintNetInstallDir)\FileTypes" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PaintNetInstallDir)\FileTypes" />
  </Target>
</Project>
